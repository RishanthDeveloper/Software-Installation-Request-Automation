# Copy this file to .env and fill in your own values. Never commit .env.

# "production" turns on secure cookies and requires JWT_SECRET.
NODE_ENV=development

# Long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# Password given to the starter accounts created by "npm run seed"
# (or automatically on first start when the database is empty).
SEED_PASSWORD=choose-a-password-1

# Where the SQLite database file is stored.
DATABASE_PATH=data/app.db

PORT=4000

# Login/registration attempts allowed per IP address per 15 minutes.
AUTH_RATE_LIMIT=20
